<?xml version="1.0" encoding="utf-8"?>
<!-- Grey dot: the port is listed but nothing is on it. On the white focused card a white-grey
     disappears, so the focused variant switches to a dark grey. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#66111111" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
</selector>
