<?xml version="1.0" encoding="utf-8"?>
<!-- One card of the source bar: icon, name, and whether anything is on the jack. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="144dp"
    android:layout_weight="1"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/source_card_bg"
    android:padding="10dp"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="17sp"
        android:fontFamily="@string/font_medium"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/stateRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:duplicateParentState="true"
        android:visibility="gone">

        <View
            android:id="@+id/dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:duplicateParentState="true"
            android:background="@drawable/status_dot" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@drawable/pill_text_mid"
            android:duplicateParentState="true"
            android:textSize="12sp"
            android:fontFamily="@string/font_regular" />
    </LinearLayout>
</LinearLayout>
